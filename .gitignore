# Existing

compile_commands.json
vim_rc
Config.json

[Bb]uild*
# build-agent.md / build-agent-notes.md are caught by [Bb]uild* above, which is
# intended: they are the local planning<->build agent channel over the shared
# mount, not repo content. Durable findings get lifted into POWER9_PORT_PLAN.md.
# ...and probe sources are worth keeping; their binaries are not
!build-probes/
build-probes/*
!build-probes/*.c
!build-probes/*.sh
!build-probes/*.pl
!build-probes/origin/
!build-probes/origin/*.c
!build-probes/origin/README
[Bb]in/
out/
.vscode/
.vs/
*.pyc
.cache
.idea/
CMakeLists.txt.user

# Reference documentation (large binaries, not redistributable here)
docs/*.pdf

# Mono crash dumps from guest harness runs
mono_crash.*

# Local-only: discovery, designs, adversarial reviews, raw agent output.
# Verified conclusions get lifted into POWER9_PORT_PLAN.md, which IS tracked.
docs/local/
